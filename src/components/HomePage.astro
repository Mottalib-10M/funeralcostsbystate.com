---
/**
 * Home (refonte du 2026-11-09, testeurs naïfs 5,0 / 4,7 / 6,0) : the question « someone has died, what does it
 * cost and what do I do », answered first. Standfirst with the national figure, the calculator in its
 * « Someone has died » mode (state cost today first, left to pay after), four things to know before paying,
 * the federal payments, the highest and lowest states; then planning ahead and the reference sections, folded
 * (`details.repli-section`) but kept in the HTML (RECETTE §5, §21).
 * Every figure comes from the engine or the parameter file.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './Tool.astro';
import Sources from './Sources.astro';
import Clamp from './Clamp.astro';
import { route } from '../i18n/routes';
import { PAGES } from '../lib/guides';
import { groupLabel, GROUPS_ORDER } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { LAST_UPDATED, AUTHOR_NAME } from '../data/site-config';
import { displayDate } from '../lib/format';
import { faqSchema, webApplicationSchema, websiteSchema, organizationSchema } from '../lib/seo';
import { FC_DEFAULTS } from '../lib/fc-defaults';
const lang = 'en';
const h = helpers(true);
const { P, E, m, pc } = h;

// The calculator's own default cases (lib/fc-defaults.ts), so the text matches what the reader sees first:
// the same engine call, the same defaults, the same trend (audit du 2026-11-09 : 10 426 $ contre 10 407 $).
const DEF = { ...FC_DEFAULTS };
const now = E.funeralGap(DEF);
const def = now; // same case, planning-ahead figures (age, sex, median, future)
const us22 = E.spendPerDeath('US');
const usNow = E.spendToday('US');
const tx = E.spendToday(DEF.state);
const rank = E.ranking();
const top = rank.slice(0, 10), bottom = rank.slice(-10).reverse();
const rowOf = (x: { s: (typeof E.STATES)[number]; v: number }) => [E.stateName(x.s), m(E.spendToday(x.s).all as number)];
const hiLo = (rank[0].v / rank[rank.length - 1].v);
const hi = rank[0].s, lo = rank[rank.length - 1].s;
const nonSvc = E.vaAllowance('nonService'), svc = E.vaAllowance('service');
const trend = E.funeralTrend(), allTrend = E.allItemsTrend();
const yoy = E.funeralYoY();
const longF = E.funeralAnnual(E.lastFullYear) / E.funeralAnnual(E.firstYear) - 1;
const longA = E.allItemsAnnual(E.lastFullYear) / E.allItemsAnnual(E.firstYear) - 1;
const cpiYears = [E.firstYear, 1995, 2000, 2005, 2010, 2015, 2020, 2022, E.lastFullYear];
const cpiRows = cpiYears.map((y) => [String(y), h.num1(E.funeralAnnual(y)), m(E.toToday(1000, y)), pc(E.funeralAnnual(E.lastFullYear) / E.funeralAnnual(y) - 1), pc(E.allItemsAnnual(E.lastFullYear) / E.allItemsAnnual(y) - 1)]);
const stName = E.stateName(DEF.state);

const nSrc = Object.keys(P.sources).length;
// Bloc citable (RECETTE §21) : un seul <p>, deux phrases visibles, la suite dépliable (Clamp). Une phrase, un chiffre.
const RESUME = `Funeral cost by state: a funeral in the United States costs about ${m(usNow.all as number)} on average today, counting funeral homes, cemeteries and crematories. In ${stName}, the example state of the calculator, it is ${m(tx.all as number)}. Each state’s figure is what these businesses took in per death in 2022, counted by the Census Bureau and brought up to today’s prices. It averages every kind of funeral, from a direct cremation to a burial with a plot and a headstone, so a real price list can sit well above or below it. Social Security pays ${m(P.ssa.lumpSum)} once to a surviving husband, wife or young child. The VA pays up to ${m(nonSvc.total)} for a veteran who meets one of its conditions. Neither is paid unless someone claims it. Everything else comes from the family: savings, a life insurance payout or the estate.`;
const faqs = [
  { q: 'What is the average cost of a funeral in the United States?', a: `Funeral homes, cemeteries and crematories took in ${m(us22.all as number)} per death in 2022, from the Census Bureau’s count of their revenue divided by the deaths of that year. Brought forward with the Labor Department’s funeral price index, that is about ${m(usNow.all as number)} in ${h.month}. It averages every kind of funeral, from a direct cremation to a full burial, so a single quote can sit well above or below it.` },
  { q: 'Which state has the most expensive funerals?', a: `On spending per death, ${E.stateName(rank[0].s)} comes first at ${m(E.spendToday(rank[0].s).all as number)} today, and ${E.stateName(rank[rank.length - 1].s)} last at ${m(E.spendToday(rank[rank.length - 1].s).all as number)}. The gap partly reflects prices and partly habits: states where cremation is common spend less per death, and cemetery sales made in advance count in the year they are made.` },
  { q: 'Does the government pay for a funeral?', a: `Not in general. Social Security pays a one-time ${m(P.ssa.lumpSum)} to a surviving spouse or an eligible child. The VA pays up to ${m(svc.burial)} toward the funeral of a veteran whose death was caused by military service, and otherwise ${m(nonSvc.burial)} plus ${m(nonSvc.plot)} for a plot when the veteran met one of its conditions, for deaths on or after ${h.D.vaFrom}. Some counties and states help with indigent burials.` },
  { q: 'Who pays for a funeral when someone dies?', a: `Whoever signs the funeral home’s contract agrees to pay it, so the family should settle who signs, and with what money, before the arrangements. The money can come from the estate, a life insurance payout, savings in a bank account that passes to the family, the ${m(P.ssa.lumpSum)} Social Security pays a surviving spouse or young child, and the VA allowance for a veteran who meets its conditions. Some counties and states help with a basic burial when there is no money.` },
  { q: 'Is it cheaper to prepay a funeral?', a: 'It can be, because a prepaid contract fixes the price of what it lists, and funeral prices keep rising. The trade is that the money is tied to one funeral home under state rules that vary, and items outside the contract are still paid at the later price. Setting money aside in a bank account payable on death to the family keeps it flexible. The prepaid page compares the two with your own figures.' },
  { q: 'Do I have to give my phone number to use the calculator?', a: 'No. There is no form, no account and no callback. Everything runs in your browser and nothing you type is sent anywhere: the address bar only holds your own figures, so that you can copy a link to share them. The site has nothing to sell and passes no details to insurers, brokers or funeral homes.' },
];
const jsonLd = [webApplicationSchema({ name: 'Funeral cost calculator by state', description: 'Funeral and cemetery spending per death in each state today, or carried to the likely age of death, after the VA allowance and the Social Security payment.', path: route('home', lang), lang }), websiteSchema(lang), organizationSchema(lang), faqSchema(faqs, lang)];
const DESC = `Funeral cost by state for 2026: what a funeral costs where you live today, or later, after the VA burial allowance, Social Security’s ${m(P.ssa.lumpSum)} and savings.`;
const groups = GROUPS_ORDER.map((g) => ({ g, pages: PAGES.filter((p) => p.group === g) })).filter((x) => x.pages.length);
---
<PageLayout title="Funeral Cost by State 2026: Calculator After VA and SSA" description={DESC} lang={lang} jsonLd={jsonLd} faqs={faqs}>
  <header class="mb-3">
    <h1 class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">Funeral costs by state: what a funeral costs today, and what is left to pay</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">A death in the United States costs about <strong>{m(usNow.all as number)}</strong> in funeral and cemetery spending today, from {m(E.spendToday(lo).all as number)} in {E.stateName(lo)} to {m(E.spendToday(hi).all as number)} in {E.stateName(hi)}. Pick the state below.</p>
    <p class="mt-1 text-xs text-navy-600">Independent site, not an insurer or a broker, and not a funeral home or a government agency. No quote form, no phone call.</p>
  </header>
  <div data-outil class="mb-4"><Tool tool={{ kind: 'funeral' }} primary={true} /></div>
  {/* Portes d'entrée par profil (testeurs naïfs du 2026-11-10, règle 2) : juste sous le calculateur, des boutons, pas un lien noyé. */}
  <nav aria-label="Start from your situation" class="not-prose mb-6 grid gap-2 sm:grid-cols-2" data-portes>
    <a href={route('va-burial-benefits', lang)} class="rounded-lg border border-navy-300 bg-white px-4 py-3 text-navy-900 hover:bg-navy-50"><span class="block font-semibold">The person was a veteran</span><span class="block text-sm text-navy-700">What the VA (Department of Veterans Affairs) pays, and who claims it</span></a>
    <a href={route('cremation-cost', lang)} class="rounded-lg border border-navy-300 bg-white px-4 py-3 text-navy-900 hover:bg-navy-50"><span class="block font-semibold">The family chose cremation</span><span class="block text-sm text-navy-700">Add up the lines of a cremation price list</span></a>
    <a href={route('funeral-costs-by-state', lang)} class="rounded-lg border border-navy-300 bg-white px-4 py-3 text-navy-900 hover:bg-navy-50"><span class="block font-semibold">Find your state, A to Z</span><span class="block text-sm text-navy-700">The average funeral cost in each of the 50 states and DC</span></a>
    <a href="#plan" class="rounded-lg border border-navy-300 bg-white px-4 py-3 text-navy-900 hover:bg-navy-50"><span class="block font-semibold">Planning your own funeral</span><span class="block text-sm text-navy-700">A woman of {DEF.age} in {stName}: about {m(def.future)} by age {Math.floor(def.median)}, the age half of women her age reach</span></a>
  </nav>
  <Clamp text={RESUME} id="clamp-home" class="mb-3" />
  <p class="mb-6 text-sm text-navy-600">Figures from the Census Bureau, the Labor Department, U.S. tables of how long people live, and Veterans Affairs · {AUTHOR_NAME} · <a href={route('method', lang)} class="underline hover:text-navy-900">How the figures are worked out</a> · <a href={route('about', lang)} class="underline hover:text-navy-900">Who publishes this site</a></p>

  <section class="not-prose mb-8 border-l-4 border-accent-600 bg-accent-50 p-4 sm:p-5" aria-labelledby="first-days">
    <h2 id="first-days" class="text-xl font-bold text-navy-900">Someone has died: four things to know before you pay</h2>
    <ol class="mt-3 list-decimal space-y-2 pl-5 text-navy-800">
      <li><strong>Call two or three funeral homes.</strong> By federal rule they must give their prices by phone, and a written General Price List (the list of every price they charge) when you visit.</li>
      <li><strong>You choose line by line.</strong> A home may not make you buy its casket or urn, nor charge you for one bought elsewhere, and may not say embalming is required when the law does not require it.</li>
      <li><strong>A direct cremation</strong>, with no viewing beforehand, is usually the lowest-priced line of the list.</li>
      <li><strong>Claim what is owed.</strong> Social Security pays {m(P.ssa.lumpSum)} once to a surviving husband or wife or a young child, claimed within {P.ssa.claimYears} years. The VA pays up to {m(nonSvc.total)} for a veteran who meets one of its conditions: <a href={route('va-burial-benefits', lang)} class="underline">who qualifies and how to claim</a>.</li>
    </ol>
    <p class="mt-3 text-sm text-navy-700">The state average mixes every kind of funeral, so a real price list can sit well above or below it. Got one? Type its total in the calculator above and it becomes your own figure.</p>
  </section>

  <section class="not-prose my-10" aria-labelledby="gov-title">
    <h2 id="gov-title" class="text-2xl font-bold text-navy-900">What the federal government pays</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <div class="border-t-4 border-navy-400 bg-navy-50 p-4"><p class="text-sm font-semibold text-navy-700">Social Security one-time payment</p><p class="tabular-nums mt-1 text-3xl font-bold text-navy-900">{m(P.ssa.lumpSum)}</p><p class="mt-2 text-sm text-navy-800">Once, to a husband or wife who lived with the person or was already getting Social Security through them, or else to a child, usually one under 18. Claim within {P.ssa.claimYears} years.</p></div>
      <div class="border-t-4 border-navy-400 bg-navy-50 p-4"><p class="text-sm font-semibold text-navy-700">Veteran, death not caused by service</p><p class="tabular-nums mt-1 text-3xl font-bold text-navy-900">{m(nonSvc.total)}</p><p class="mt-2 text-sm text-navy-800">{m(nonSvc.burial)} for the burial plus {m(nonSvc.plot)} for the plot, only if the veteran was on a VA pension or disability pay, had a claim open, or died in VA care.</p></div>
      <div class="border-t-4 border-accent-600 bg-accent-50 p-4"><p class="text-sm font-semibold text-navy-700">Veteran, death caused by service</p><p class="tabular-nums mt-1 text-3xl font-bold text-navy-900">{m(svc.burial)}</p><p class="mt-2 text-sm text-navy-800">A single sum, for a death on or after September 11, 2001. The VA may also pay to move the remains to a VA national cemetery.</p></div>
    </div>
    <p class="mt-4 text-sm text-navy-700">Neither is paid unless someone claims it. The VA amounts change every October 1.</p>
  </section>

  <section class="not-prose my-10" aria-labelledby="states-title">
    <h2 id="states-title" class="text-2xl font-bold text-navy-900">Funeral cost by state: the highest and the lowest</h2>
    <p class="mt-2 text-navy-800">Funeral and cemetery spending per death, at today’s prices. The highest state is {h.num1(hiLo)} times the lowest.</p>
    <div class="mt-4 grid gap-6 sm:grid-cols-2">
      <Fragment set:html={h.table(['The 10 highest', 'Per death today'], top.map(rowOf), 'Census Bureau, 2022 Economic Census and population estimates; Bureau of Labor Statistics funeral price index.', ['l', 'r'])} />
      <Fragment set:html={h.table(['The 10 lowest', 'Per death today'], bottom.map(rowOf), 'Same sources, lowest first.', ['l', 'r'])} />
    </div>
    <p class="mt-4"><a href={route('funeral-costs-by-state', lang)} class="inline-block rounded-lg border border-accent-600 px-4 py-2 font-semibold text-accent-700 hover:bg-accent-50">Your state is not here? Every state, A to Z</a></p>
  </section>

  <div class="prose prose-slate max-w-none">
    <details class="repli-section"><summary>How the figures are worked out, and what they leave out</summary>
      <p>Every five years the Census Bureau counts the revenue of the country’s death-care businesses, by state. The 2022 count found {h.num(us22.establishments ?? 0)} funeral homes, cemeteries and crematories and a total revenue of {m(E.spendPerDeath('US').all as number * us22.deaths / 1e9)} billion, against about {h.num(Math.round(us22.deaths / 1000) * 1000)} deaths that year. Dividing one by the other gives {m(us22.all as number)} per death: {m(us22.homes as number)} at funeral homes and {m(us22.cemeteries as number)} at cemeteries and crematories. It is what these businesses took in from all their buyers, not a list price and not the bill of any one family.</p>
      <p>Three things push the figure away from one family’s bill. It averages a direct cremation with no service and a full burial with a casket, a vault, a plot and a headstone. Cemeteries sell plots and contracts years in advance, and the money counts in the year of the sale. And revenue counts where the business sits, so a family that buys across a state line moves the figure with it. For Alaska and Wyoming the Census publishes only the total, not the split between funeral homes and cemeteries.</p>
      <p>The 2022 figure is brought to today with the Labor Department’s monthly index of funeral prices. Funeral prices rose {pc(longF)} from {E.firstYear} to {E.lastFullYear}, against {pc(longA)} for all consumer prices. Over the last ten full years they rose {pc(trend, 1)} a year, against {pc(allTrend, 1)} for everything; that ten-year rate is the one the Planning ahead button uses.</p>
      <Fragment set:html={h.table(['Year', 'Funeral index', `$1,000 then, in ${h.month}`, `Funeral prices to ${E.lastFullYear}`, 'All prices, same years'], cpiRows, 'BLS consumer price index, U.S. city average, not seasonally adjusted: funeral expenses and all items. December 1986 = 100.', ['l', 'r', 'r', 'r', 'r'])} />
      <p>Planning ahead takes the age that half the people of your age and sex in your state live past, from the state life tables (official tables of how long people live) of the National Center for Health Statistics. A quarter of people live well past it, and the longer the wait, the more a fixed sum loses to rising prices.</p>
      <p>The calculator does not count flowers, travel, a reception or the death certificates the family orders, unless the funeral home bills them. It does not count county help with a burial when there is no money, a union or employer death benefit, or Social Security survivor benefits, which replace income rather than pay for a funeral. It counts savings and insurance as the same thing, money available when it is needed, though a policy pays within days or weeks and an estate can take months to settle. The <a href={route('method', lang)}>method page</a> sets out every step.</p>
    </details>

    <details class="repli-section"><summary>Sources</summary>
      <Sources lang={lang} intro="The spending per death, the funeral price index, the life tables and the VA and Social Security amounts above come from these Census, BLS, NCHS, VA and eCFR pages, last read on" />
      <p>The parameter file cites {nSrc} pages: the Census Bureau’s <Fragment set:html={h.src('census_ec', '2022 Economic Census data files')} /> and <Fragment set:html={h.src('census_pop', 'population estimates')} />, the NCHS <Fragment set:html={h.src('nchs_states', 'state life tables')} />, the BLS <Fragment set:html={h.src('bls_cpi', 'funeral price index')} />, the VA’s <Fragment set:html={h.src('va_burial', 'burial allowance page')} />, the <Fragment set:html={h.src('ftc_rule', 'FTC Funeral Rule')} /> and the <Fragment set:html={h.src('ssa_cfr', 'Social Security regulation')} /> on the eCFR (Electronic Code of Federal Regulations). VA amounts from va.gov, page updated {h.date(P.va.pageUpdated)}. Every sum is checked against cases worked out by hand each time the site is rebuilt.</p>
    </details>
  </div>

  <section class="mt-10" aria-labelledby="guides-title">
    <details class="repli-section"><summary><h2 id="guides-title" class="text-xl font-bold text-navy-900">Every calculator on the site</h2></summary>
    <div class="mt-2 space-y-6 pb-4">
      {groups.map(({ g, pages }) => (
        <div class="grid gap-2 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-6">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-navy-600">{groupLabel(g)}</h3>
          <ul class="space-y-2">{pages.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p.nav}</a> <span class="text-sm text-navy-600">{p.card}</span></li>)}</ul>
        </div>
      ))}
    </div>
    </details>
  </section>
</PageLayout>
